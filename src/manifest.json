{
    "manifest_version": 3,
    "name": "No Not Again",
    "short_name": "No Not Again",
    "version": "1.0.1",
    "description": "Shows personal notes before accessing specified websites",
    "homepage_url": "https://github.com/chapagainmanoj/NoNotAgain",
    "minimum_chrome_version": "102",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "permissions": ["storage", "tabs", "declarativeNetRequest"],
    "host_permissions": ["http://*/*", "https://*/*"],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "No Not Again",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png"
        }
    },
    "web_accessible_resources": [
        {
            "resources": ["note-page.html"],
            "matches": ["http://*/*", "https://*/*"]
        }
    ]
}
