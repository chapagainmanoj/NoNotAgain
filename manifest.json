{
  "manifest_version": 3,
  "name": "No Not Again",
  "version": "1.0",
  "description": "Shows personal notes before accessing specified websites",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "No Not Again"
  },
  "web_accessible_resources": [
    {
      "resources": ["note-page.html"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}